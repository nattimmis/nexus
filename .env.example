# Nexus Environment Configuration
# Copy this file to .env and fill in your credentials

# Pinata IPFS API Credentials
# Get free account at: https://pinata.cloud
PINATA_API_KEY=your_pinata_api_key_here
PINATA_API_SECRET=your_pinata_api_secret_here

# Logging Configuration
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Playwright Browser Configuration (optional)
# Set to true for headless browser mode (no visible window)
NEXUS_HEADLESS=false

# Playback Configuration (optional)
# Set to false to continue on assertion failures instead of stopping
NEXUS_STRICT_ASSERTIONS=true

# IPFS Gateway Configuration (optional)
# Defaults to: https://gateway.pinata.cloud/ipfs
# Alternative: https://ipfs.io/ipfs
# NEXUS_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs

# Development Configuration (optional)
# Used for testing and debugging
DEBUG=false
